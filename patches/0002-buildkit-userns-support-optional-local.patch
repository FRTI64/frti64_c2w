diff --git a/executor/oci/spec_linux.go b/executor/oci/spec_linux.go
index 2e1430a..7d19539 100644
--- a/executor/oci/spec_linux.go
+++ b/executor/oci/spec_linux.go
@@ -37,6 +37,33 @@ const (
 	tracingSocketPath = "/dev/otel-grpc.sock"
 )
 
+
+// PATCH(c2w-local): patchUserNSMounts adjusts the default OCI mounts for a
+// user namespace with a single mapped ID. It drops privileged mounts
+// (sysfs/cgroupfs/mqueue) and maps devpts to gid 0. This is only used for
+// building in restricted sandboxes and does not affect process semantics that
+// matter for compiling software.
+func patchUserNSMounts(mounts []specs.Mount) []specs.Mount {
+	ret := make([]specs.Mount, 0, len(mounts))
+	for _, m := range mounts {
+		switch m.Destination {
+		case "/dev/pts":
+			opts := make([]string, 0, len(m.Options))
+			for _, o := range m.Options {
+				if strings.HasPrefix(o, "gid=") {
+					o = "gid=0"
+				}
+				opts = append(opts, o)
+			}
+			m.Options = opts
+		case "/sys", "/sys/fs/cgroup", "/dev/mqueue":
+			continue
+		}
+		ret = append(ret, m)
+	}
+	return ret
+}
+
 func withProcessArgs(args ...string) oci.SpecOpts {
 	return oci.WithProcessArgs(args...)
 }
