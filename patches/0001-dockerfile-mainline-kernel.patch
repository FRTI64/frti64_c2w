 FROM golang-base AS bundle-dev
+# Rootless buildkit maps a single UID in its user namespace, so it cannot
+# chown extracted layers to the uid/gid stored in the VM rootfs tarball.
+# container2wasm's create-spec honors _NO_SAME_OWNER=1 to skip that
+# (see cmd/create-spec/main.go).  Required for non-root local builds.
+ENV _NO_SAME_OWNER=1
