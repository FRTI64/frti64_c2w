+ARG LINUX_VERSION=v7.3.3
+ARG LINUX_GIT_URL=https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git
+# qemu-wasm (QEMU 8.2 wasm JIT) mis-emulates RISC-V Zbb instructions that Linux >= 6.4
+# uses in its Zbb-optimized strlen/strcmp alternatives (orc.b/rev8), which corrupts guest
+# memory. Hide Zbb from the emulated CPU so the guest kernel uses its generic routines.
+ARG QEMU_RISCV_CPU_OPTS=rv64,zbb=false
