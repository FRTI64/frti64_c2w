 COPY --link --from=assets /config/qemu/args-riscv64.json.template /args.json.template
+# PATCH(c2w-local): pin the emulated RISC-V CPU model. qemu-wasm's wasm JIT does not
+# correctly emulate the Zbb extension, which mainline kernels >= 6.4 use in optimized
+# string routines; the resulting memory corruption crashes guest userland (e.g. runc).
+RUN sed -i "s/\"-nographic\"/\"-cpu\", \"${QEMU_RISCV_CPU_OPTS}\", \"-nographic\"/" /args.json.template && \
